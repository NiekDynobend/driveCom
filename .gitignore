# PlatformIO build output, downloaded toolchains and libraries
.pio/

# VS Code files that PlatformIO regenerates on every build
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# CMake build folder (laptop simulation / tests, if built from here)
build/
out/

# Compiled objects and binaries
*.o
*.obj
*.elf
*.bin
*.hex
*.map
*.exe
*.pdb
*.ilk

# Editor / OS clutter
.vs/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
